{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FRAZIL: build windows-debug (safe)",
      "type": "process",
      "command": "python",
      "args": [
        "tools/build_safe.py",
        "--preset",
        "windows-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
