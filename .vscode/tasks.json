{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FRAZIL: build windows-debug",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "windows-debug", "--parallel", "4"],
      "options": {
        "env": {
          "PATH": "${workspaceFolder}\\tools\\bin;${env:PATH}"
        }
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
