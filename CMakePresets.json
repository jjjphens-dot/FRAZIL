        }
      }
    },
    {
      "name": "windows-debug-smoke",
      "execution": {
        "noTestsAction": "error",
        "jobs": 1
      },
      "filter": {
        "include": {
          "name": "^frazil_smoke$"
        }
      },
      "configurePreset": "windows-debug-all",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-debug-core",
      "execution": {
        "noTestsAction": "error",
        "jobs": 1
      },
      "filter": {
        "include": {
          "label": "^fast-core$"
        }
